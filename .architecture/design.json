              "value": "1px solid var(--color-border)"
            },
            {
              "name": "border-radius",
              "value": "var(--radius-lg)"
            },
            {
              "name": "box-shadow",
              "value": "var(--shadow-sm)"
            },
            {
              "name": "transition",
              "value": "transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base)"
            }
          ]
        },
        {
          "selector": ".card-interactive:hover",
          "properties": [
            {
              "name": "transform",
              "value": "translateY(-2px)"
            },
            {
              "name": "box-shadow",
              "value": "var(--shadow-md)"
            },
            {
              "name": "border-color",
              "value": "var(--color-brand-border-strong)"
            }
          ]
        }
      ]
    }
  ]
}